page { height: 100%; overflow: hidden; background: #69c9f1; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; }
.game-page { position: relative; width: 100%; height: 100vh; min-height: 1180rpx; overflow: hidden; color: #633f24; }
.scene-background, .scene-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.scene-background { z-index: 0; }
.scene-shade { z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(55,182,239,.06), transparent 30%, rgba(86,51,18,.05)); }

.top-safe-area { position: absolute; z-index: 20; top: 0; left: 0; right: 0; height: 104rpx; padding-top: calc(env(safe-area-inset-top) + 12rpx); display: flex; align-items: center; justify-content: space-between; box-sizing: content-box; }
.header-left { display: flex; align-items: center; gap: 18rpx; margin-left: 24rpx; }
.setting-button { position: relative; width: 82rpx; height: 82rpx; border-radius: 50%; background: linear-gradient(145deg,#fff,#edf5f7); box-shadow: 0 9rpx 0 #c8d9dc,0 11rpx 18rpx rgba(40,90,70,.22),inset 0 3rpx 0 #fff; }
.header-icon, .action-icon, .reward-icon, .tab-icon { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; }
.icon-preview { position: absolute; z-index: 1; left: 50%; top: 50%; transform: translate(-50%,-50%); font-size: 46rpx; line-height: 1; }
.icon-settings { color: #798d93; font-size: 52rpx; text-shadow: 0 2rpx 0 #fff; }
.coin-counter { position: relative; width: 134rpx; height: 62rpx; padding-left: 48rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border: 5rpx solid rgba(255,255,255,.92); border-radius: 38rpx; background: rgba(255,255,255,.88); box-shadow: 0 7rpx 0 rgba(124,152,153,.48),0 10rpx 18rpx rgba(34,80,70,.16); }
.coin-star-wrap { position: absolute; left: -24rpx; top: -17rpx; width: 78rpx; height: 78rpx; }
.coin-star { position: absolute; inset: 0; color: #ffd33f; font-size: 76rpx; line-height: 78rpx; text-align: center; -webkit-text-stroke: 4rpx #e89920; text-shadow: 0 6rpx 0 #c67518; }
.coin-value { font-size: 32rpx; font-weight: 900; color: #6a4930; }
.native-capsule-space { width: 190rpx; height: 72rpx; margin-right: 20rpx; }

.game-stage { position: absolute; z-index: 5; top: calc(env(safe-area-inset-top) + 120rpx); left: 0; right: 0; bottom: 236rpx; }
.progress-track { position: absolute; left: 50%; top: 0; bottom: 0; width: 250rpx; transform: translateX(-50%); }
.progress-line { position: absolute; left: 50%; top: 13%; bottom: 10%; width: 13rpx; transform: translateX(-50%); border-radius: 12rpx; background: repeating-linear-gradient(180deg,#d3a36a 0,#d3a36a 15rpx,#f2c990 15rpx,#f2c990 28rpx); box-shadow: inset 3rpx 0 3rpx rgba(106,66,29,.2); }
.level-node { position: absolute; left: 50%; width: 126rpx; height: 126rpx; transform: translateX(-50%) scale(.88); filter: saturate(.78); z-index: 3; }
.level-6 { top: 1%; transform: translateX(-50%) scale(.70); }
.level-5 { top: 20%; transform: translateX(-50%) scale(.76); }
.level-4 { top: 39%; transform: translateX(-50%) scale(.82); }
.level-3 { top: 58%; transform: translateX(-50%) scale(.90); }
.level-2 { bottom: 1%; transform: translateX(-50%) scale(1); }
.wood-disc { position: absolute; z-index: 5; inset: 0; display: flex; align-items: center; justify-content: center; border: 8rpx solid #9b5b28; border-radius: 50%; background: radial-gradient(circle at 35% 30%,rgba(255,255,255,.42) 0 5%,transparent 6%),repeating-radial-gradient(ellipse at 58% 58%,#e9b867 0 9rpx,#dfa354 10rpx 14rpx,#efc474 15rpx 22rpx); box-shadow: 0 12rpx 0 #764119,0 17rpx 18rpx rgba(79,45,17,.28),inset 0 5rpx 0 rgba(255,255,255,.35); }
.wood-disc::after { content: ""; position: absolute; inset: 12rpx; border: 3rpx dashed rgba(129,73,27,.25); border-radius: 50%; }
.wood-disc text { position: relative; z-index: 2; color: #714019; font-size: 57rpx; font-weight: 900; text-shadow: 0 4rpx 0 rgba(255,225,159,.72); }
.level-active { filter: none; }
.level-active .wood-disc { border-color: #a86125; }
.wood-stack { position: absolute; z-index: 2; left: 50%; top: 55rpx; width: 174rpx; height: 95rpx; transform: translateX(-50%); }
.wood-plank { position: absolute; left: 50%; width: 164rpx; height: 54rpx; transform: translateX(-50%); border: 5rpx solid #8f5024; border-radius: 50%; background: linear-gradient(180deg,#d99547 0 46%,#aa6129 48% 100%); box-shadow: 0 7rpx 0 #6f3b1b; }
.plank-back { top: 0; width: 142rpx; }
.plank-middle { top: 24rpx; width: 158rpx; }
.plank-front { top: 47rpx; }

.reward-bubble { position: absolute; z-index: 12; left: 142rpx; top: -12rpx; width: 120rpx; min-height: 104rpx; padding: 8rpx 8rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 5rpx solid rgba(255,255,255,.95); border-radius: 30rpx; box-sizing: border-box; background: rgba(255,255,255,.92); box-shadow: 0 8rpx 0 rgba(164,151,128,.43),0 12rpx 18rpx rgba(75,55,25,.2); }
.bubble-tail { position: absolute; left: -16rpx; top: 40rpx; width: 28rpx; height: 28rpx; transform: rotate(45deg); border-left: 5rpx solid #fff; border-bottom: 5rpx solid #fff; background: #fff; }
.reward-icon { position: absolute; top: 6rpx; left: 22rpx; width: 76rpx; height: 58rpx; }
.reward-preview { font-size: 42rpx; line-height: 48rpx; }
.reward-label { font-size: 23rpx; font-weight: 900; color: #65472f; white-space: nowrap; }
.pin-preview { height: 52rpx; display: flex; align-items: center; transform: rotate(-8deg); }
.pin-preview text { font-size: 30rpx; margin: 0 -3rpx; }
.reward-key { transform: scale(1.2); transform-origin: left center; }

.side-actions { position: absolute; top: 4%; bottom: 4%; width: 142rpx; display: flex; flex-direction: column; justify-content: space-around; align-items: center; z-index: 10; }
.side-actions-left { left: 8rpx; }
.side-actions-right { right: 8rpx; padding-top: 7%; padding-bottom: 7%; box-sizing: border-box; }
.side-action { width: 138rpx; display: flex; flex-direction: column; align-items: center; }
.action-icon-shell { position: relative; width: 96rpx; height: 82rpx; border: 5rpx solid rgba(255,255,255,.85); border-radius: 28rpx; box-shadow: 0 8rpx 0 rgba(92,73,43,.35),0 12rpx 15rpx rgba(55,70,38,.18),inset 0 4rpx 0 rgba(255,255,255,.45); }
.blue-shell { background: linear-gradient(145deg,#7ddafa,#3f98dd); }
.pink-shell { background: linear-gradient(145deg,#ffb6d6,#ef70a8); }
.red-shell { background: linear-gradient(145deg,#ff9b85,#e94f4c); }
.yellow-shell { background: linear-gradient(145deg,#fff391,#f4b62e); }
.white-shell { background: linear-gradient(145deg,#fff,#e7f1f0); }
.wood-shell { background: linear-gradient(145deg,#d79b5b,#965327); border-color: #f1c17b; }
.action-label { margin-top: 9rpx; padding: 3rpx 9rpx; border-radius: 12rpx; background: rgba(255,255,255,.88); box-shadow: 0 4rpx 0 rgba(112,91,57,.28); color: #5e422c; font-size: 23rpx; font-weight: 900; line-height: 1.4; white-space: nowrap; text-shadow: 0 2rpx 0 #fff; }
.star-preview { color: #ffd42f; font-size: 66rpx; -webkit-text-stroke: 3rpx #e49125; }
.puzzle-preview { font-size: 54rpx; }
.podium-preview { position: absolute; left: 13rpx; right: 13rpx; bottom: 10rpx; height: 57rpx; display: flex; align-items: flex-end; justify-content: center; }
.podium-preview text { width: 24rpx; padding-top: 7rpx; color: white; font-size: 20rpx; font-weight: 900; text-align: center; background: #ee5b4f; border-radius: 5rpx 5rpx 0 0; }
.podium-preview text:nth-child(1) { height: 30rpx; }
.podium-preview text:nth-child(2) { height: 44rpx; background: #f3c12f; }
.podium-preview text:nth-child(3) { height: 24rpx; background: #61aee8; }

.start-button { position: absolute; z-index: 30; left: 50%; bottom: 142rpx; width: 320rpx; height: 92rpx; margin: 0; padding: 0; transform: translateX(-50%); display: flex; align-items: center; justify-content: center; border: 8rpx solid #f9ffe7; border-radius: 52rpx; background: linear-gradient(180deg,#9bec42 0%,#63c52e 62%,#4aab21 100%); box-shadow: 0 13rpx 0 #33891c,0 18rpx 22rpx rgba(57,82,24,.34),inset 0 7rpx 0 rgba(255,255,255,.45); color: white; font-size: 42rpx; font-weight: 900; letter-spacing: 5rpx; text-shadow: 0 5rpx 0 #3a941e; }
.start-button::after { border: 0; }
.start-button-pressed { transform: translate(-50%,8rpx); box-shadow: 0 5rpx 0 #33891c; }

.tab-bar { position: absolute; z-index: 25; left: 0; right: 0; bottom: 0; height: calc(108rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); display: flex; align-items: center; justify-content: space-around; box-sizing: border-box; border-top: 7rpx solid #eac896; background: linear-gradient(180deg,#efd6ae,#cfa87a); box-shadow: 0 -8rpx 18rpx rgba(76,58,33,.2),inset 0 5rpx 0 rgba(255,255,255,.36); }
.tab-item { position: relative; width: 150rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; }
.tab-item-active::before { content: ""; position: absolute; inset: 8rpx 20rpx; border-radius: 40rpx; background: rgba(255,255,255,.28); }
.tab-icon { left: 30rpx; width: 90rpx; height: 86rpx; }
.tab-preview { position: relative; z-index: 1; font-size: 65rpx; line-height: 1; filter: drop-shadow(0 5rpx 0 rgba(106,65,29,.25)); }
.tab-star { position: absolute; z-index: 2; top: 5rpx; right: 31rpx; color: #ffd32d; font-size: 31rpx; -webkit-text-stroke: 2rpx #d98c22; }
.button-pressed { transform: translateY(6rpx); box-shadow: 0 3rpx 0 #c8d9dc; }

@media (max-height: 650px) {
  .game-page { min-height: 100vh; }
  .game-stage { top: calc(env(safe-area-inset-top) + 104rpx); bottom: 210rpx; }
  .side-actions { transform: scale(.88); transform-origin: center; }
  .start-button { bottom: 128rpx; height: 82rpx; }
}
